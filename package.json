{
  "name": "instagram-library",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:lint": "markdownlint \"**/*.md\" \".cursor/rules/*.mdc\" --ignore node_modules --ignore dist --dot --ignore .local-tools",
    "docs:links": "node scripts/check-doc-links.mjs",
    "docs:check": "npm run docs:lint && npm run docs:links",
    "local:setup": "node scripts/setup-local.mjs",
    "db:up": "docker compose -p instagram-library up -d --wait",
    "db:stop": "docker compose -p instagram-library stop",
    "smoke:local": "node --env-file-if-exists=.env --import tsx scripts/smoke-local.ts",
    "runtime:start": "node scripts/start-runtime.mjs",
    "auth:setup": "tsx scripts/setup-auth.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.54.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.12"
    },
    "markdownlint-cli": {
      "js-yaml": "^5.4.3",
      "smol-toml": "^1.9.0"
    },
    "micromark-extension-math": {
      "katex": "^0.18.2"
    }
  }
}
